                  "disabled": false,
                  "key": "days_to_compute",
                  "value": "14",
                  "description": "Number of days to use for APR calculation (must be positive)"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "vault_address",
                  "description": "(Required) Vault contract address (normalized to lowercase)"
                }
              ]
            },
            "header": [
