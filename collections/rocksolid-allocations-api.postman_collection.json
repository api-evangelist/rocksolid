                  "key": "period-id",
                  "value": "<integer>",
                  "description": "(Required) Allocation period ID"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "vault_address",
                  "description": "(Required) Vault contract address (normalized to lowercase)"
